<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/*.jpg" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/offline-map-tiles.zip" LogicalName="WpfSatelliteTracking.OfflineMapTiles" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="SGP.NET" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/satellites.tle" LogicalName="WpfSatelliteTracking.TleCatalog" /></ItemGroup>
</Project>
